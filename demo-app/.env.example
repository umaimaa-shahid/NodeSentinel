# MongoDB connection strings (local MongoDB or Docker container)
VULN_MONGODB_URI=mongodb://127.0.0.1:27017/demo_vulnerable
SECURE_MONGODB_URI=mongodb://127.0.0.1:27017/demo_secure

# Server bindings (localhost only)
VULN_HOST=127.0.0.1
VULN_PORT=3001
SECURE_HOST=127.0.0.1
SECURE_PORT=3002

# JWT settings
VULN_JWT_SECRET=secret123
# Generate a unique SECURE_JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Allowed CORS origins for the secure app (comma-separated)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
